# Optional. Used only to build absolute Open Graph URLs.
# Vercel provides VERCEL_URL automatically when this is unset.
# This is not a secret. Do not put database passwords or service-role keys here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No Supabase, database, or auth variables are read by this application.
# When a backend is added, keep the service-role key in server env only.
# Never prefix a service-role key with NEXT_PUBLIC_.
